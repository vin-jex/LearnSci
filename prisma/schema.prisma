generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          Role     @default(LEARNER)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempts Attempt[]

  @@map("users")
}

model Topic {
  id          String   @id @default(cuid())
  title       String
  description String
  duration    String
  order       Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons      Lesson[]
  keyTerms     KeyTerm[]
  questions    Question[]
  attempts     Attempt[]
  translations Translation[]

  @@map("topics")
}

model Lesson {
  id        String   @id @default(cuid())
  topicId   String
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  translations Translation[]

  @@map("lessons")
}

model KeyTerm {
  id              String  @id @default(cuid())
  topicId         String
  englishTerm     String
  igboTerm        String
  igboExplanation String?

  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  translations Translation[]

  @@map("key_terms")
}

model Question {
  id            String       @id @default(cuid())
  topicId       String
  type          QuestionType
  questionText  String
  options       Json?
  correctAnswer String
  feedbackRules Json
  difficulty    Float        @default(0.5) // 0.0 easy → 1.0 hard, updated by adaptive engine
  embedding     Json? // stored as number[] for semantic similarity
  createdAt     DateTime     @default(now())

  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  translations Translation[]

  @@map("questions")
}

model Attempt {
  id                 String         @id @default(cuid())
  userId             String
  topicId            String
  score              Float
  classification     Classification
  weakAreas          Json?
  predictedWeakAreas Json? // ML prediction made mid-quiz
  idempotencyKey     String?        @unique // prevents duplicate submissions
  createdAt          DateTime       @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("attempts")
}

model Translation {
  id             String   @id @default(cuid())
  entityType     String // "topic" | "lesson" | "keyterm" | "question"
  entityId       String
  locale         String // "ig"
  field          String // "title" | "content" | "questionText" | "defaultFeedback" etc
  originalText   String
  translatedText String
  model          String // HF model used
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Polymorphic relations — only one will be set
  topicId    String?
  lessonId   String?
  keyTermId  String?
  questionId String?

  topic    Topic?    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  lesson   Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  keyTerm  KeyTerm?  @relation(fields: [keyTermId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([entityId, locale, field])
  @@map("translations")
}

model LearnerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  weaknessEmbedding Json? // float[] — updated after each attempt
  strengthAreas     Json? // string[] of topicIds learner is strong in
  recommendedTopics Json? // string[] of topicIds ranked by relevance
  lastUpdated       DateTime @default(now())

  @@map("learner_profiles")
}

enum Role {
  LEARNER
  ADMIN
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum Classification {
  STRONG
  MODERATE
  WEAK
}
