generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String
  role          Role     @default(LEARNER)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempts Attempt[]

  @@map("users")
}

model Topic {
  id              String   @id @default(cuid())
  title           String
  titleIgbo       String?
  description     String
  descriptionIgbo String?
  duration        String
  order           Int      @default(0)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lessons   Lesson[]
  keyTerms  KeyTerm[]
  questions Question[]
  attempts  Attempt[]

  @@map("topics")
}

model Lesson {
  id          String   @id @default(cuid())
  topicId     String
  content     String
  igboContent String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model KeyTerm {
  id              String  @id @default(cuid())
  topicId         String
  englishTerm     String
  igboTerm        String
  igboExplanation String?

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("key_terms")
}

model Question {
  id            String       @id @default(cuid())
  topicId       String
  type          QuestionType
  questionText  String
  questionTextIgbo String?
  options       Json?
  optionsIgbo   Json?
  correctAnswer String
  feedbackRules Json         // { misconceptions, defaultFeedback, defaultFeedbackIgbo? }
  difficulty    Float        @default(0.5)
  embedding     Json?
  createdAt     DateTime     @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model Attempt {
  id                 String         @id @default(cuid())
  userId             String
  topicId            String
  score              Float
  classification     Classification
  weakAreas          Json?
  predictedWeakAreas Json?
  idempotencyKey     String?        @unique
  createdAt          DateTime       @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("attempts")
}

model LearnerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  weaknessEmbedding Json?
  strengthAreas     Json?
  recommendedTopics Json?
  lastUpdated       DateTime @default(now())

  @@map("learner_profiles")
}

enum Role {
  LEARNER
  ADMIN
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum Classification {
  STRONG
  MODERATE
  WEAK
}
