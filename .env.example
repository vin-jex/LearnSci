# Database (Neon)
# Get this from: Neon Dashboard → Your Project → Connection Details → Node.js
# Important: use the -pooler URL for better connection handling
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"
# Generate with: openssl rand -base64 32
